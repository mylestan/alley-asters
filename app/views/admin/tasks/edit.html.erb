<p style="margin-bottom: 16px;"><a href="<%= admin_tasks_path %>">&larr; Back to tasks</a></p>

<h1 style="font-size: 1.5em; font-weight: bold; margin-bottom: 24px;">Edit: <%= @task.title %></h1>

<% if flash[:notice] %>
  <div style="background-color: #dcfce7; border: 1px solid #86efac; color: #166534; padding: 12px; border-radius: 4px; margin-bottom: 16px;">
    <%= flash[:notice] %>
  </div>
<% end %>

<% if flash[:alert] %>
  <div style="background-color: #fee2e2; border: 1px solid #fca5a5; color: #991b1b; padding: 12px; border-radius: 4px; margin-bottom: 16px;">
    <%= flash[:alert] %>
  </div>
<% end %>

<%= render "form", task: @task, plots: @plots, url: admin_task_path(@task), method: :patch %>

<% if @task.completers.any? %>
  <hr style="margin: 32px 0; border: none; border-top: 1px solid #ccc;">
  <h2 style="font-size: 1.2em; font-weight: bold; margin-bottom: 12px;">Completed by</h2>
  <ul>
    <% @task.completers.each do |user| %>
      <li><%= user.first_name.present? ? "#{user.first_name} #{user.last_name}" : user.email %></li>
    <% end %>
  </ul>
<% end %>

<hr style="margin: 32px 0; border: none; border-top: 1px solid #ccc;">

<%= button_to "Delete this task", admin_task_path(@task), method: :delete,
  form: { onsubmit: "return confirm('Are you sure you want to delete this task?')" },
  style: "background: none; border: 1px solid #991b1b; color: #991b1b; padding: 8px 16px; border-radius: 4px; cursor: pointer; font-family: inherit;" %>
