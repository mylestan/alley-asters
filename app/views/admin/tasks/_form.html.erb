<% field_style = "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-family: inherit; box-sizing: border-box;" %>
<% label_style = "display: block; font-weight: bold; margin-bottom: 4px;" %>
<% group_style = "margin-bottom: 16px;" %>

<%= form_with model: task, url: url, method: method do |f| %>
  <div style="<%= group_style %>">
    <label style="<%= label_style %>">Title</label>
    <%= f.text_field :title, required: true, style: field_style %>
  </div>

  <div style="<%= group_style %>">
    <label style="<%= label_style %>">Description</label>
    <%= f.text_area :description, rows: 3, style: field_style %>
  </div>

  <div style="<%= group_style %>">
    <label style="<%= label_style %>">Plot</label>
    <%= f.collection_select :plot_id, plots, :id, :display_name, { prompt: "Select plot..." }, style: field_style %>
  </div>

  <% all_tools = Tool.order(:name) %>
  <% if all_tools.any? %>
    <div style="<%= group_style %>">
      <label style="<%= label_style %>">Required tools</label>
      <div style="max-height: 150px; overflow-y: auto; border: 1px solid #ccc; border-radius: 4px; padding: 8px;">
        <% all_tools.each do |tool| %>
          <label style="display: flex; align-items: center; gap: 6px; padding: 2px 0;">
            <%= check_box_tag "required_tool_ids[]", tool.id, task.required_tools.include?(tool) %>
            <%= tool.name %>
          </label>
        <% end %>
      </div>
    </div>

    <div style="<%= group_style %>">
      <label style="<%= label_style %>">Suggested tools</label>
      <div style="max-height: 150px; overflow-y: auto; border: 1px solid #ccc; border-radius: 4px; padding: 8px;">
        <% all_tools.each do |tool| %>
          <label style="display: flex; align-items: center; gap: 6px; padding: 2px 0;">
            <%= check_box_tag "suggested_tool_ids[]", tool.id, task.suggested_tools.include?(tool) %>
            <%= tool.name %>
          </label>
        <% end %>
      </div>
    </div>
  <% end %>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; <%= group_style %>">
    <div>
      <label style="<%= label_style %>">Completed at</label>
      <%= f.datetime_local_field :completed_at, style: field_style %>
    </div>
    <div>
      <label style="<%= label_style %>">Completion notes</label>
      <%= f.text_field :completion_notes, style: field_style %>
    </div>
  </div>

  <button type="submit"
    style="background-color: #3d3d6b; color: white; padding: 10px 24px; border: none; border-radius: 4px; cursor: pointer; font-family: inherit; font-size: 1em;">
    Save
  </button>
<% end %>
