<h1 style="font-size: 1.5em; font-weight: bold; margin-bottom: 24px;">Inventory</h1>

<% if flash[:notice] %>
  <div style="background-color: #dcfce7; border: 1px solid #86efac; color: #166534; padding: 12px; border-radius: 4px; margin-bottom: 16px;">
    <%= flash[:notice] %>
  </div>
<% end %>

<% if flash[:alert] %>
  <div style="background-color: #fee2e2; border: 1px solid #fca5a5; color: #991b1b; padding: 12px; border-radius: 4px; margin-bottom: 16px;">
    <%= flash[:alert] %>
  </div>
<% end %>

<div style="display: flex; gap: 20px; margin-bottom: 24px;">
  <div style="background-color: white; padding: 16px 24px; border-radius: 8px; text-align: center;">
    <div style="font-size: 1.8em; font-weight: bold; color: #2e7d32;"><%= @total_ready %></div>
    <div style="color: #666; font-size: 0.9em;">Ready</div>
  </div>
  <div style="background-color: white; padding: 16px 24px; border-radius: 8px; text-align: center;">
    <div style="font-size: 1.8em; font-weight: bold; color: #f57c00;"><%= @total_not_ready %></div>
    <div style="color: #666; font-size: 0.9em;">Not Ready</div>
  </div>
  <div style="background-color: white; padding: 16px 24px; border-radius: 8px; text-align: center;">
    <div style="font-size: 1.8em; font-weight: bold; color: #3d3d6b;"><%= @total_ready + @total_not_ready %></div>
    <div style="color: #666; font-size: 0.9em;">Total</div>
  </div>
</div>

<%= form_with model: @item, url: admin_inventory_path, style: "display: flex; gap: 8px; align-items: flex-end; margin-bottom: 32px;" do |f| %>
  <div style="flex: 2; position: relative;">
    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Plant</label>
    <%= f.hidden_field :plant_id, id: "inventory-plant-id" %>
    <input type="text" id="inventory-plant-search" placeholder="Search plants..." autocomplete="off"
      style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-family: inherit; box-sizing: border-box;" />
    <div id="inventory-plant-results" style="display: none; position: absolute; z-index: 10; width: 100%; max-height: 200px; overflow-y: auto; background: white; border: 1px solid #ccc; border-radius: 4px; margin-top: 2px;">
    </div>
    <script>
      (function() {
        var plants = <%= raw @plants.map { |p| { id: p.id, name: p.name, latin: p.latin_name } }.to_json %>;
        var input = document.getElementById('inventory-plant-search');
        var hidden = document.getElementById('inventory-plant-id');
        var results = document.getElementById('inventory-plant-results');

        input.addEventListener('input', function() {
          var q = input.value.toLowerCase();
          hidden.value = '';
          if (q.length === 0) { results.style.display = 'none'; return; }
          var matches = plants.filter(function(p) {
            return p.name.toLowerCase().includes(q) || (p.latin && p.latin.toLowerCase().includes(q));
          });
          if (matches.length === 0) { results.style.display = 'none'; return; }
          results.innerHTML = matches.map(function(p) {
            var label = p.name + (p.latin ? ' — ' + p.latin : '');
            return '<div data-id="' + p.id + '" data-name="' + p.name + '" style="padding: 6px 8px; cursor: pointer;" onmouseover="this.style.backgroundColor=\'#e5e5ff\'" onmouseout="this.style.backgroundColor=\'white\'">' + label + '</div>';
          }).join('');
          results.style.display = 'block';
        });

        results.addEventListener('click', function(e) {
          var el = e.target.closest('[data-id]');
          if (!el) return;
          hidden.value = el.dataset.id;
          input.value = el.dataset.name;
          results.style.display = 'none';
        });

        document.addEventListener('click', function(e) {
          if (!results.contains(e.target) && e.target !== input) {
            results.style.display = 'none';
          }
        });
      })();
    </script>
  </div>
  <div style="flex: 0 0 80px;">
    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Qty</label>
    <%= f.number_field :quantity, min: 0, value: 1,
      style: "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-family: inherit; box-sizing: border-box;" %>
  </div>
  <div style="flex: 1;">
    <label style="display: block; font-weight: bold; margin-bottom: 4px;">Status</label>
    <%= f.select :status, InventoryItem::STATUSES.map { |s| [s.humanize, s] }, {},
      style: "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-family: inherit; box-sizing: border-box;" %>
  </div>
  <button type="submit"
    style="background-color: #3d3d6b; color: white; padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer; font-family: inherit; white-space: nowrap;">
    Add
  </button>
<% end %>

<% if @items.any? %>
  <p style="color: #666; margin-bottom: 12px;"><%= @items.count %> item<%= @items.count == 1 ? "" : "s" %></p>
  <table style="width: 100%; border-collapse: collapse;">
    <thead>
      <tr style="border-bottom: 2px solid #999; text-align: left;">
        <th style="padding: 8px 0;">Plant</th>
        <th style="padding: 8px 0;">Qty</th>
        <th style="padding: 8px 0;">Status</th>
        <th style="padding: 8px 0;"></th>
      </tr>
    </thead>
    <tbody>
      <% @items.each do |item| %>
        <tr style="border-bottom: 1px solid #ddd;">
          <td style="padding: 10px 0;">
            <%= item.plant.name %>
            <% if item.plant.latin_name.present? %>
              <span style="color: #666; font-style: italic;"> — <%= item.plant.latin_name %></span>
            <% end %>
          </td>
          <td style="padding: 10px 0;"><%= item.quantity %></td>
          <td style="padding: 10px 0;">
            <% if item.status == "ready" %>
              <span style="background-color: #dcfce7; color: #166534; padding: 2px 8px; border-radius: 3px; font-size: 0.85em;">Ready</span>
            <% else %>
              <span style="background-color: #fff3e0; color: #f57c00; padding: 2px 8px; border-radius: 3px; font-size: 0.85em;">Not ready</span>
            <% end %>
          </td>
          <td style="padding: 10px 0; text-align: right; white-space: nowrap;">
            <a href="<%= edit_admin_inventory_item_path(item) %>" style="color: #3d3d6b; margin-right: 12px;">Edit</a>
            <%= button_to "Remove", admin_inventory_item_path(item), method: :delete,
              form: { onsubmit: "return confirm('Remove this inventory item?')" },
              style: "background: none; border: none; color: #991b1b; cursor: pointer; font-family: inherit; font-size: 0.9em;" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p style="color: #666;">No inventory items yet.</p>
<% end %>
