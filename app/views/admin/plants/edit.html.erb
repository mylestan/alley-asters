<% field_style = "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-family: inherit; box-sizing: border-box;" %>
<% label_style = "display: block; font-weight: bold; margin-bottom: 4px;" %>
<% group_style = "margin-bottom: 16px;" %>

<p style="margin-bottom: 16px;"><a href="<%= admin_plants_path %>">&larr; Back to plants</a></p>

<h1 style="font-size: 1.5em; font-weight: bold; margin-bottom: 24px;">Edit: <%= @plant.name %></h1>

<% if flash[:alert] %>
  <div style="background-color: #fee2e2; border: 1px solid #fca5a5; color: #991b1b; padding: 12px; border-radius: 4px; margin-bottom: 16px;">
    <%= flash[:alert] %>
  </div>
<% end %>

<%= form_with model: @plant, url: admin_plant_path(@plant), method: :patch do |f| %>
  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; <%= group_style %>">
    <div>
      <label style="<%= label_style %>">Common name</label>
      <%= f.text_field :name, required: true, style: field_style %>
    </div>
    <div>
      <label style="<%= label_style %>">Latin name</label>
      <%= f.text_field :latin_name, style: field_style %>
    </div>
  </div>

  <div style="display: flex; gap: 16px; <%= group_style %>">
    <label style="display: flex; align-items: center; gap: 4px;">
      <%= f.check_box :is_native %> Native
    </label>
    <label style="display: flex; align-items: center; gap: 4px;">
      <%= f.check_box :invasive %> Invasive
    </label>
    <label style="display: flex; align-items: center; gap: 4px;">
      <%= f.check_box :nativar %> Nativar
    </label>
    <label style="display: flex; align-items: center; gap: 4px;">
      <%= f.check_box :cultivar %> Cultivar
    </label>
  </div>

  <button type="submit"
    style="background-color: #3d3d6b; color: white; padding: 10px 24px; border: none; border-radius: 4px; cursor: pointer; font-family: inherit; font-size: 1em;">
    Save
  </button>
<% end %>
