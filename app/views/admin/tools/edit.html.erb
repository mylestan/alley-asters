<% field_style = "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-family: inherit; box-sizing: border-box;" %>
<% label_style = "display: block; font-weight: bold; margin-bottom: 4px;" %>
<% group_style = "margin-bottom: 16px;" %>

<p style="margin-bottom: 16px;"><a href="<%= admin_tools_path %>">&larr; Back to tools</a></p>

<h1 style="font-size: 1.5em; font-weight: bold; margin-bottom: 24px;">Edit: <%= @tool.name %></h1>

<% if flash[:notice] %>
  <div style="background-color: #dcfce7; border: 1px solid #86efac; color: #166534; padding: 12px; border-radius: 4px; margin-bottom: 16px;">
    <%= flash[:notice] %>
  </div>
<% end %>

<% if flash[:alert] %>
  <div style="background-color: #fee2e2; border: 1px solid #fca5a5; color: #991b1b; padding: 12px; border-radius: 4px; margin-bottom: 16px;">
    <%= flash[:alert] %>
  </div>
<% end %>

<%= form_with model: @tool, url: admin_tool_path(@tool), method: :patch, multipart: true do |f| %>
  <div style="<%= group_style %>">
    <label style="<%= label_style %>">Name</label>
    <%= f.text_field :name, required: true, style: field_style %>
  </div>

  <div style="<%= group_style %>">
    <label style="<%= label_style %>">Photo</label>
    <% if @tool.photo.attached? %>
      <div style="margin-bottom: 8px;">
        <%= image_tag url_for(@tool.photo), style: "width: 100px; height: 100px; object-fit: cover; border-radius: 4px;" %>
      </div>
    <% end %>
    <%= f.file_field :photo, accept: "image/*", style: "font-family: inherit;" %>
  </div>

  <div style="<%= group_style %>">
    <label style="<%= label_style %>">Usage instructions</label>
    <%= f.text_area :usage_text, rows: 4, style: field_style %>
  </div>

  <div style="display: flex; gap: 16px; <%= group_style %>">
    <label style="display: flex; align-items: center; gap: 4px;">
      <%= f.check_box :self_serve %> Self-serve
    </label>
    <label style="display: flex; align-items: center; gap: 4px;">
      <%= f.check_box :by_request %> By request
    </label>
  </div>

  <button type="submit"
    style="background-color: #3d3d6b; color: white; padding: 10px 24px; border: none; border-radius: 4px; cursor: pointer; font-family: inherit; font-size: 1em;">
    Save
  </button>
<% end %>

<hr style="margin: 32px 0; border: none; border-top: 1px solid #ccc;">

<%= button_to "Delete this tool", admin_tool_path(@tool), method: :delete,
  form: { onsubmit: "return confirm('Are you sure you want to delete #{j(@tool.name)}?')" },
  style: "background: none; border: 1px solid #991b1b; color: #991b1b; padding: 8px 16px; border-radius: 4px; cursor: pointer; font-family: inherit;" %>
