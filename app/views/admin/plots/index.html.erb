<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
  <h1 style="font-size: 1.5em; font-weight: bold; margin: 0;">Plots</h1>
  <a href="<%= new_admin_plot_path %>"
    style="background-color: #3d3d6b; color: white; padding: 8px 16px; border-radius: 4px; text-decoration: none; font-size: 0.9em;">
    + New Plot
  </a>
</div>

<% if flash[:notice] %>
  <div style="background-color: #dcfce7; border: 1px solid #86efac; color: #166534; padding: 12px; border-radius: 4px; margin-bottom: 16px;">
    <%= flash[:notice] %>
  </div>
<% end %>

<div style="display: flex; gap: 8px; margin-bottom: 16px;">
  <% [["All", nil], ["Planted", "planted"], ["Planned", "planned"], ["Potential", "potential"]].each do |label, value| %>
    <% active = @status_filter == value %>
    <a href="<%= admin_plots_path(status: value) %>"
      style="padding: 6px 14px; border-radius: 4px; text-decoration: none; font-size: 0.9em;
        <%= active ? "background-color: #3d3d6b; color: white;" : "background-color: white; color: #3d3d6b; border: 1px solid #ccc;" %>">
      <%= label %>
    </a>
  <% end %>
</div>

<div id="admin-map" style="width: 100%; height: 350px; border-radius: 8px; margin-bottom: 16px;"></div>

<script>
  function initMap() {
    const plots = <%= raw @plots.select { |p| p.latitude.present? && p.longitude.present? }.map { |p|
      { lat: p.latitude.to_f, lng: p.longitude.to_f, name: p.display_name, status: p.status, url: edit_admin_plot_path(p) }
    }.to_json %>;

    const statusColors = {
      planted: "#166534",
      planned: "#1565c0",
      potential: "#999999"
    };

    const bounds = new google.maps.LatLngBounds();
    const map = new google.maps.Map(document.getElementById("admin-map"), {
      mapId: "admin-plots-map"
    });

    plots.forEach(function(plot) {
      const position = { lat: plot.lat, lng: plot.lng };

      const pin = new google.maps.marker.PinElement({
        background: statusColors[plot.status] || "#999",
        borderColor: statusColors[plot.status] || "#999",
        glyphColor: "white"
      });

      const marker = new google.maps.marker.AdvancedMarkerElement({
        map: map,
        position: position,
        title: plot.name,
        content: pin.element
      });

      marker.addListener("click", function() {
        window.open(plot.url, '_blank');
      });

      bounds.extend(position);
    });

    if (plots.length > 0) {
      map.fitBounds(bounds, 50);
    }
  }
</script>
<script async defer
  src="https://maps.googleapis.com/maps/api/js?key=<%= Rails.application.credentials.dig(:google, :maps_api_key) %>&callback=initMap&libraries=marker&v=weekly">
</script>

<p style="color: #666; margin-bottom: 12px;"><%= @plots.count %> plot<%= @plots.count == 1 ? "" : "s" %></p>

<table style="width: 100%; border-collapse: collapse;">
  <thead>
    <tr style="border-bottom: 2px solid #999; text-align: left;">
      <th style="padding: 8px 0;">Name</th>
      <th style="padding: 8px 0;">Status</th>
      <th style="padding: 8px 0;">Sq. Ft.</th>
      <th style="padding: 8px 0;">% Native</th>
      <th style="padding: 8px 0;"></th>
    </tr>
  </thead>
  <tbody>
    <% @plots.each do |plot| %>
      <tr style="border-bottom: 1px solid #ddd;">
        <td style="padding: 10px 0;">
          <%= plot.display_name %>
          <% if plot.latitude.blank? || plot.longitude.blank? %>
            <span style="background-color: #fef3c7; color: #92400e; padding: 2px 6px; border-radius: 3px; font-size: 0.8em; margin-left: 6px;">No location</span>
          <% end %>
          <% if plot.status == "planted" && (plot.square_footage.blank? || plot.square_footage == 0) %>
            <span style="background-color: #fef3c7; color: #92400e; padding: 2px 6px; border-radius: 3px; font-size: 0.8em; margin-left: 6px;">No sq ft</span>
          <% end %>
          <% if plot.status == "planted" && (plot.native_plant_coverage_percent.blank? || plot.native_plant_coverage_percent == 0) %>
            <span style="background-color: #fef3c7; color: #92400e; padding: 2px 6px; border-radius: 3px; font-size: 0.8em; margin-left: 6px;">No coverage</span>
          <% end %>
        </td>
        <td style="padding: 10px 0;">
          <% color = case plot.status
               when "planted" then "#166534"
               when "planned" then "#1565c0"
               when "potential" then "#666"
             end
             bg = case plot.status
               when "planted" then "#dcfce7"
               when "planned" then "#e3f2fd"
               when "potential" then "#eee"
             end %>
          <span style="background-color: <%= bg %>; color: <%= color %>; padding: 2px 8px; border-radius: 3px; font-size: 0.85em;"><%= plot.status %></span>
        </td>
        <td style="padding: 10px 0;"><%= plot.square_footage || "—" %></td>
        <td style="padding: 10px 0;"><%= plot.native_plant_coverage_percent ? "#{(plot.native_plant_coverage_percent * 100).round}%" : "—" %></td>
        <td style="padding: 10px 0; text-align: right;">
          <a href="<%= edit_admin_plot_path(plot) %>" target="_blank" style="color: #3d3d6b;">Edit</a>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
