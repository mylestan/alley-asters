  <h1>Gardens</h1>
  <p>Click on a pin to learn more about a specific plot.</p>
  <div id="map" style="width: 100%; height: 450px; border-radius: 8px;"></div>

  <script>
    function initMap() {
      const plots = <%= raw @plots.where.not(latitude: nil, longitude: nil).map { |p|
        { lat: p.latitude.to_f, lng: p.longitude.to_f, name: p.name, url: "/plots/#{p.slug}" }
      }.to_json %>;

      const bounds = new google.maps.LatLngBounds();
      const map = new google.maps.Map(document.getElementById("map"), {
        mapId: "alley-asters-map"
      });

      plots.forEach(function(plot) {
        const position = { lat: plot.lat, lng: plot.lng };
        const marker = new google.maps.marker.AdvancedMarkerElement({
          map: map,
          position: position,
          title: plot.name
        });

        marker.addListener("click", function() {
          window.location.href = plot.url;
        });

        bounds.extend(position);
      });

      map.fitBounds(bounds, 50);
    }
  </script>
  <script async defer
    src="https://maps.googleapis.com/maps/api/js?key=<%= Rails.application.credentials.dig(:google, :maps_api_key) %>&callback=initMap&libraries=marker&v=weekly">
  </script>

