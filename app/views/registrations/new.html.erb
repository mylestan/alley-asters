<div style="max-width: 400px; margin: 80px auto; padding: 40px; background-color: #E5E5FF;">
  <h1 style="font-size: 1.5em; font-weight: bold; margin-bottom: 24px;">Sign Up</h1>

  <% if flash[:alert] %>
    <div style="background-color: #fee2e2; border: 1px solid #fca5a5; color: #991b1b; padding: 12px; border-radius: 4px; margin-bottom: 16px;">
      <%= flash[:alert] %>
    </div>
  <% end %>

  <%= form_with model: @user, url: signup_path do |f| %>
    <div style="margin-bottom: 16px;">
      <label for="email" style="display: block; font-weight: bold; margin-bottom: 4px;">Email</label>
      <%= f.email_field :email, required: true, autofocus: true,
        style: "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-family: inherit; box-sizing: border-box;" %>
    </div>

    <div style="margin-bottom: 16px;">
      <label for="password" style="display: block; font-weight: bold; margin-bottom: 4px;">Password</label>
      <%= f.password_field :password, required: true,
        style: "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-family: inherit; box-sizing: border-box;" %>
    </div>

    <div style="margin-bottom: 24px;">
      <label for="password_confirmation" style="display: block; font-weight: bold; margin-bottom: 4px;">Confirm password</label>
      <%= f.password_field :password_confirmation, required: true,
        style: "width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; font-family: inherit; box-sizing: border-box;" %>
    </div>

    <button type="submit"
      style="background-color: #3d3d6b; color: white; padding: 10px 24px; border: none; border-radius: 4px; cursor: pointer; font-family: inherit; font-size: 1em;">
      Sign up
    </button>
  <% end %>
</div>
