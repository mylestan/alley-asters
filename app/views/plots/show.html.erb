<header style="padding: 16px 24px;">
  <a href="<%= root_path %>">
    <img src="/img/alley-asters-logotype-transparent.png" alt="Alley Asters" style="height: 50px;">
  </a>
</header>
<div id="container">
  <p><a href="<%= root_path %>">&larr; Back to all gardens</a></p>

  <h1><%= @plot.display_name %></h1>

  <% if @plot.first_planted.present? %>
    <p>First planted: <%= @plot.first_planted.strftime("%B %Y") %></p>
  <% end %>
  <% if @plot.plants_removed.present? %>
    <p>Previous contents: <%= @plot.plants_removed %></p>
  <% end %>
  <% if @plot.initial_plant_count.present? %>
    <p>Initial planting: <%= @plot.initial_plant_count %> plants</p>
  <% end %>
  <% if @plot.square_footage.present? %>
    <p>Size: ~<%= @plot.square_footage %> sq. ft</p>
  <% end %>
  <% if @plot.notes.present? %>
    <p>Notes: <%= @plot.notes %></p>
  <% end %>

  <% unless @plot.managed_by_us %>
    <p><em>This plot is not managed by Alley Asters.</em></p>
  <% end %>
  <% unless @plot.has_signage %>
    <p><em>This plot does not have signage.</em></p>
  <% end %>

  <% if @plot.plants.any? %>
    <% plants_list = @plot.plants.order(:name) %>
    <% has_large_plants = plants_list.any? { |p| %w[canopy understory].include?(p.canopy_layer) } %>
    <h2>Plants</h2>
    <ul>
      <% plants_list.each do |plant| %>
        <li>
          <%= plant.name %><% if %w[canopy understory].include?(plant.canopy_layer) %>*<% end %>
          <% if plant.latin_name.present? %>
            <span style="color: #666; font-style: italic;"> — <%= plant.latin_name %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% if has_large_plants %>
      <p style="color: #666; font-size: 0.9em;">*Larger plants listed may overhang the plot instead of being planted directly in the plot.</p>
    <% end %>
  <% end %>

  <% if @plot.photos.any? %>
    <div class="image-container">
      <% @plot.photos.each do |photo| %>
        <div class="image-card">
          <%= image_tag url_for(photo.image), alt: photo.caption %>
          <% if photo.caption.present? %>
            <p><%= photo.caption %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
