<header style="padding: 16px 24px;">
  <a href="<%= root_path %>">
    <img src="/img/alley-asters-logotype-transparent.png" alt="Alley Asters" style="height: 50px;">
  </a>
</header>
<div id="container" style="padding: 40px 100px 100px;">
  <p><a href="<%= root_path %>">&larr; Back to all gardens</a></p>

  <h1><%= @plot.display_name %></h1>

  <% if @plot.first_planted.present? %>
    <p>First planted: <%= @plot.first_planted.strftime("%B %Y") %></p>
  <% end %>
  <% if @plot.plants_removed.present? %>
    <p>Previous contents: <%= @plot.plants_removed %></p>
  <% end %>
  <% if @plot.initial_plant_count.present? %>
    <p>Initial planting: <%= @plot.initial_plant_count %> plants</p>
  <% end %>
  <% if @plot.square_footage.present? %>
    <p>Size: ~<%= @plot.square_footage %> sq. ft</p>
  <% end %>
  <% if @plot.notes.present? %>
    <p>Notes: <%= @plot.notes %></p>
  <% end %>

  <% if @plot.photos.any? %>
    <div class="image-container">
      <% @plot.photos.each do |photo| %>
        <div class="image-card">
          <%= image_tag url_for(photo.image), alt: photo.caption %>
          <% if photo.caption.present? %>
            <p><%= photo.caption %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
